---
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Professional video-based software to analyze sprint performance. Measure force, time, and velocity metrics with the CONTEMPLAS mobile track set-up."
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://contemplas.com').toString();
const ogImage = 'https://contemplas.com/og-image.jpg';

const orgJsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "CONTEMPLAS GmbH",
	"url": "https://contemplas.com",
	"logo": "https://contemplas.com/favicon.svg",
	"email": "info@contemplas.com",
	"telephone": "+49-831-25436920",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "Albert-Einstein-Straße 6",
		"postalCode": "87437",
		"addressLocality": "Kempten",
		"addressCountry": "DE"
	}
};

const productJsonLd = {
	"@context": "https://schema.org",
	"@type": "Product",
	"name": "CONTEMPLAS Sprint Analysis Set-up",
	"description": description,
	"brand": { "@type": "Brand", "name": "CONTEMPLAS" },
	"category": "Sports performance analysis software"
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#21354e" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="CONTEMPLAS" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<title>{title}</title>

		<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
	</head>
	<body class="bg-brand-light text-brand-text min-h-screen flex flex-col selection:bg-brand-red selection:text-white relative overflow-x-hidden">
		<slot />

		<!-- Sticky 'Schedule a Call' Button -->
		<div class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-50">
			<a href="#contact" class="flex items-center gap-2 bg-brand-red text-white py-3 px-6 rounded-full font-bold shadow-lg hover:shadow-xl hover:-translate-y-1 hover:bg-opacity-90 transition-all duration-300">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
				</svg>
				Schedule a call
			</a>
		</div>
	</body>
</html>
