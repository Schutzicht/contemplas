---
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-6xl z-50 bg-white/95 backdrop-blur-md border border-brand-gray-border/50 shadow-lg shadow-brand-dark/5 rounded-2xl transition-all duration-500" id="main-header">
  <div class="px-4 sm:px-6 lg:px-6 transition-all duration-500" id="header-inner">
    <div class="flex justify-between items-center h-16 transition-all duration-500" id="header-nav">
      
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center">
          <img src="/Input visuals contemplas/logo.webp" alt="CONTEMPLAS Logo" class="h-6 w-auto transition-all duration-500" id="header-logo" style="filter: brightness(0);">
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-8 items-center" id="desktop-nav">
        <a href="#advantage" class="text-brand-text hover:text-brand-red transition-colors text-sm font-semibold tracking-wide">The Advantage</a>
        <a href="#equipment" class="text-brand-text hover:text-brand-red transition-colors text-sm font-semibold tracking-wide">Equipment</a>
        <a href="#testimonials" class="text-brand-text hover:text-brand-red transition-colors text-sm font-semibold tracking-wide">Proof</a>
        <a href="#video-overview" class="text-brand-text hover:text-brand-red transition-colors text-sm font-semibold tracking-wide">Video</a>
        <a href="#contact" class="bg-brand-red text-white hover:bg-opacity-90 px-5 py-2 rounded-full text-sm font-bold shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5" id="header-cta">Contact Us</a>
      </nav>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button type="button" class="text-brand-dark hover:text-brand-red focus:outline-none" aria-controls="mobile-menu" aria-expanded="false" id="mobile-menu-btn">
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="md:hidden hidden bg-white border-t border-brand-gray-border/50 absolute w-full left-0 mt-2 rounded-xl shadow-xl overflow-hidden" id="mobile-menu">
    <div class="px-4 py-4 space-y-3">
      <a href="#advantage" class="block text-brand-dark hover:text-brand-red font-medium rounded-md px-3 py-2 hover:bg-brand-light-alt">The Advantage</a>
      <a href="#equipment" class="block text-brand-dark hover:text-brand-red font-medium rounded-md px-3 py-2 hover:bg-brand-light-alt">Equipment</a>
      <a href="#testimonials" class="block text-brand-dark hover:text-brand-red font-medium rounded-md px-3 py-2 hover:bg-brand-light-alt">Proof</a>
      <a href="#video-overview" class="block text-brand-dark hover:text-brand-red font-medium rounded-md px-3 py-2 hover:bg-brand-light-alt">Video</a>
      <a href="#contact" class="block bg-brand-red text-white text-center font-bold px-3 py-3 rounded-md mt-4 shadow-sm">Contact Us</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('main-header');
  const navArea = document.getElementById('header-nav');
  const logo = document.getElementById('header-logo');

  // Mobile menu toggle
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // Scroll shrink effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      // Shrunk state
      header.classList.add('max-w-4xl');
      header.classList.remove('max-w-6xl');
      navArea.classList.add('h-12');
      navArea.classList.remove('h-16');
      logo.classList.add('h-5');
      logo.classList.remove('h-6');
    } else {
      // Default state
      header.classList.add('max-w-6xl');
      header.classList.remove('max-w-4xl');
      navArea.classList.add('h-16');
      navArea.classList.remove('h-12');
      logo.classList.add('h-6');
      logo.classList.remove('h-5');
    }
  });
</script>
