---
---

<section id="contact" class="py-16 lg:py-24 bg-brand-light-alt border-b border-brand-gray-border/50 relative overflow-hidden">
  
  <!-- Subtle background pattern or color accent -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-brand-red/5 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center">
      
      <!-- Left content -->
      <div class="flex flex-col">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-red/10 text-brand-red text-xs font-bold tracking-widest uppercase mb-6 self-start">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
          Contact Sales
        </div>

        <h2 class="text-4xl lg:text-5xl font-black text-brand-dark mb-6 leading-tight">
          Request System <br/><span class="text-brand-red">Information</span>
        </h2>
        <p class="text-lg text-brand-text-muted mb-8 max-w-lg leading-relaxed">
          Connect with our technical specialists to discuss how the CONTEMPLAS Sprint Analysis Set-up can be integrated into your professional track and field program.
        </p>
        
        <ul class="space-y-4 mb-4">
          <li class="flex items-center text-brand-dark font-medium text-base">
            <div class="w-6 h-6 rounded-full bg-brand-red/10 flex items-center justify-center mr-3 text-brand-red">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            Technical system specifications & capabilities
          </li>
          <li class="flex items-center text-brand-dark font-medium text-base">
            <div class="w-6 h-6 rounded-full bg-brand-red/10 flex items-center justify-center mr-3 text-brand-red">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            Customized hardware set-up consultation
          </li>
          <li class="flex items-center text-brand-dark font-medium text-base">
            <div class="w-6 h-6 rounded-full bg-brand-red/10 flex items-center justify-center mr-3 text-brand-red">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            Comprehensive pricing tailored to your needs
          </li>
        </ul>
      </div>

      <!-- Right Form -->
      <div class="bg-white rounded-2xl shadow-xl border border-brand-gray-border/50 p-8 md:p-12 relative overflow-hidden">
        
        <!-- Form Accent -->
        <div class="absolute top-0 left-0 w-full h-1 bg-brand-red"></div>

        <form class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="firstName" class="block text-sm font-bold text-brand-dark mb-1.5">First Name *</label>
              <input type="text" id="firstName" class="w-full bg-brand-light-alt border border-brand-gray-border rounded-md px-4 py-3 text-brand-dark focus:bg-white focus:border-brand-red focus:outline-none focus:ring-1 focus:ring-brand-red transition-all" required>
            </div>
            <div>
              <label for="lastName" class="block text-sm font-bold text-brand-dark mb-1.5">Last Name *</label>
              <input type="text" id="lastName" class="w-full bg-brand-light-alt border border-brand-gray-border rounded-md px-4 py-3 text-brand-dark focus:bg-white focus:border-brand-red focus:outline-none focus:ring-1 focus:ring-brand-red transition-all" required>
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-bold text-brand-dark mb-1.5">Professional Email Address *</label>
            <input type="email" id="email" class="w-full bg-brand-light-alt border border-brand-gray-border rounded-md px-4 py-3 text-brand-dark focus:bg-white focus:border-brand-red focus:outline-none focus:ring-1 focus:ring-brand-red transition-all" placeholder="e.g. name@university.edu" required>
          </div>

          <div>
            <label for="organization" class="block text-sm font-bold text-brand-dark mb-1.5">Organization / Federation *</label>
            <input type="text" id="organization" class="w-full bg-brand-light-alt border border-brand-gray-border rounded-md px-4 py-3 text-brand-dark focus:bg-white focus:border-brand-red focus:outline-none focus:ring-1 focus:ring-brand-red transition-all" required>
          </div>

          <button type="submit" class="w-full bg-brand-red hover:bg-opacity-90 text-white font-bold text-base py-3.5 rounded-md mt-6 transition-all shadow-md hover:shadow-lg">
            Send Message
          </button>
          
          <p class="text-xs text-brand-text-muted text-center mt-4">
            By submitting your email, you agree to our privacy policy.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
