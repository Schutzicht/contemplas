---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-dark text-brand-light-alt py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 mb-16">

      <!-- Company Info -->
      <div class="col-span-1 md:col-span-5 lg:col-span-4">
         <div class="flex-shrink-0 flex items-center mb-6">
          <a href="/" class="flex items-center opacity-90 hover:opacity-100 transition-opacity" aria-label="CONTEMPLAS home">
            <Image
              src={logo}
              alt="CONTEMPLAS"
              widths={[160, 320]}
              sizes="160px"
              formats={['avif', 'webp']}
              loading="lazy"
              class="h-8 w-auto"
              style="filter: brightness(0) invert(1);"
            />
          </a>
        </div>
        <p class="text-sm text-brand-light-alt/60 mb-6 max-w-sm leading-relaxed">
          Professional video analysis software and hardware solutions for High-Performance Track and Field analytics.
        </p>
        <div class="text-sm text-brand-light-alt/80 flex flex-col gap-2">
          <a href="mailto:info@contemplas.com" class="hover:text-white transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            info@contemplas.com
          </a>
          <a href="tel:+4983125436920" class="hover:text-white transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            +49 831 25436920
          </a>
        </div>
      </div>

      <!-- Spacer -->
      <div class="hidden lg:block lg:col-span-4"></div>

      <!-- Quick Links -->
      <div class="col-span-1 md:col-span-3 lg:col-span-2">
        <h4 class="font-bold text-sm text-white mb-6">Solutions</h4>
        <nav class="flex flex-col gap-4">
          <a href="#advantage" class="text-brand-light-alt/60 hover:text-brand-red transition-colors text-sm">System Advantage</a>
          <a href="#equipment" class="text-brand-light-alt/60 hover:text-brand-red transition-colors text-sm">Hardware Setup</a>
          <a href="#testimonials" class="text-brand-light-alt/60 hover:text-brand-red transition-colors text-sm">Case Studies</a>
          <a href="#video-overview" class="text-brand-light-alt/60 hover:text-brand-red transition-colors text-sm">Video Overview</a>
        </nav>
      </div>

       <div class="col-span-1 md:col-span-4 lg:col-span-2">
        <h4 class="font-bold text-sm text-white mb-6">Legal</h4>
        <nav class="flex flex-col gap-4">
          <a href="https://contemplas.com/en/imprint/" rel="noopener" class="text-brand-light-alt/60 hover:text-white transition-colors text-sm">Imprint</a>
          <a href="https://contemplas.com/en/privacy-policy/" rel="noopener" class="text-brand-light-alt/60 hover:text-white transition-colors text-sm">Privacy Policy</a>
        </nav>
      </div>
    </div>

    <div class="pt-8 border-t border-brand-light-alt/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-brand-light-alt/50 text-xs">
        &copy; {currentYear} CONTEMPLAS GmbH. All rights reserved. Video Analysis Software for Track and Field.
      </p>
      <address class="not-italic text-xs text-brand-light-alt/50">
        Albert-Einstein-Straße 6, 87437 Kempten, Germany
      </address>
    </div>
  </div>
</footer>
