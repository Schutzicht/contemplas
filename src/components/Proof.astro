---
---

<section id="testimonials" class="py-16 lg:py-24 bg-white border-b border-brand-gray-border/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 text-center">
      <h2 class="text-brand-red font-bold tracking-widest uppercase text-sm mb-3">Efficacy and Adoption</h2>
      <p class="text-2xl md:text-3xl text-brand-dark font-black max-w-3xl mx-auto">
        Validated by leading national federations and high-performance training centers globally.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch mb-20">
      <!-- Main Testimonial Card -->
      <div class="bg-brand-light-alt rounded-2xl p-10 md:p-14 flex flex-col justify-between border border-brand-gray-border/50 shadow-sm">
        <blockquote class="text-xl md:text-2xl text-brand-dark font-medium leading-relaxed mb-8 italic">
          "By combining motion data with force, Sprint Start Analysis allows us to objectively optimize the most critical phase of the race. The delivery of precise, actionable data directly to coaching staff has proven highly effective."
        </blockquote>
        
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-white border border-brand-gray-border flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div class="text-left">
             <div class="text-brand-dark font-bold text-base">International Sprint Coach</div>
             <div class="text-brand-text-muted text-sm">National Athletics Federation</div>
          </div>
        </div>
      </div>

       <!-- Metrics List -->
       <div class="bg-brand-light-alt rounded-2xl p-10 md:p-14 border border-brand-gray-border/50 shadow-sm flex flex-col justify-center">
          <h3 class="font-bold text-brand-dark mb-8 text-xl border-b border-brand-gray-border/50 pb-4">System Performance</h3>
          <dl class="space-y-8">
            <div class="flex justify-between items-center border-b border-brand-gray-border/30 pb-4">
              <dt class="text-sm font-bold text-brand-text-muted uppercase tracking-wide">Elite Starts Processed</dt>
              <dd class="text-3xl font-black text-brand-red">640+</dd>
            </div>
            <div class="flex justify-between items-center border-b border-brand-gray-border/30 pb-4">
              <dt class="text-sm font-bold text-brand-text-muted uppercase tracking-wide">Hardware Reliability</dt>
              <dd class="text-3xl font-black text-brand-red">100%</dd>
            </div>
            <div class="flex justify-between items-center">
              <dt class="text-sm font-bold text-brand-text-muted uppercase tracking-wide">Data Delivery Time</dt>
              <dd class="text-3xl font-black text-brand-red">&lt; 1s</dd>
            </div>
          </dl>
       </div>
    </div>

    <!-- Client Logos (White Background specifically requested for white-bg logos) -->
    <div class="pt-12">
      <h3 class="text-sm font-bold text-brand-text-muted text-center uppercase tracking-widest mb-10">Trusted by High-Performance Centers</h3>
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16">
        <div class="bg-white p-4 rounded-xl shadow-sm border border-brand-gray-border/30 hover:shadow-md transition-shadow">
          <img src="/Input visuals contemplas/abtp-logo.webp" alt="ABTP" class="h-16 w-auto object-contain">
        </div>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-brand-gray-border/30 hover:shadow-md transition-shadow">
          <img src="/Input visuals contemplas/baspo-logo.webp" alt="BASPO" class="h-16 w-auto object-contain">
        </div>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-brand-gray-border/30 hover:shadow-md transition-shadow">
          <img src="/Input visuals contemplas/hochschule-offenburg-logo.webp" alt="Hochschule Offenburg" class="h-16 w-auto object-contain">
        </div>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-brand-gray-border/30 hover:shadow-md transition-shadow">
          <img src="/Input visuals contemplas/tu-dortmund-logo.webp" alt="TU Dortmund" class="h-16 w-auto object-contain">
        </div>
      </div>
    </div>

  </div>
</section>
